{
  "info": {
    "_postman_id": "gallero-collection-id",
    "name": "Gallero API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"1234567890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/request-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "request-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"1234567890\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Set PIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/set-pin",
              "host": ["{{base_url}}"],
              "path": ["auth", "set-pin"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"1234567890\",\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Nombre del Usuario\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Fights",
      "item": [
        {
          "name": "List Fights",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/fights?status=OPEN&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["fights"],
              "query": [
                { "key": "status", "value": "OPEN" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Fight",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"red_party_name\": \"Gallo Rojo\",\n  \"green_party_name\": \"Gallo Verde\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/fights",
              "host": ["{{base_url}}"],
              "path": ["fights"]
            }
          }
        },
        {
          "name": "Get Fight by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/fights/:id",
              "host": ["{{base_url}}"],
              "path": ["fights", ":id"],
              "variable": [
                { "key": "id", "value": "uuid-placeholder" }
              ]
            }
          }
        },
        {
          "name": "Resolve Fight",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"result\": \"RED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/fights/:id/resolve",
              "host": ["{{base_url}}"],
              "path": ["fights", ":id", "resolve"],
              "variable": [
                { "key": "id", "value": "uuid-placeholder" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bets",
      "item": [
        {
          "name": "List My Bets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bets/me?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["bets", "me"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Bet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fight_id\": \"uuid-placeholder\",\n  \"side\": \"RED\",\n  \"bet_type\": \"PAREJA\",\n  \"amount_staked\": 100.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/bets",
              "host": ["{{base_url}}"],
              "path": ["bets"]
            }
          }
        }
      ]
    },
    {
      "name": "Wallets",
      "item": [
        {
          "name": "Get My Wallet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/wallets/me",
              "host": ["{{base_url}}"],
              "path": ["wallets", "me"]
            }
          }
        },
        {
          "name": "Get Wallet Ledger",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/wallets/me/ledger?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["wallets", "me", "ledger"],
