                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Deposit Funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/wallets/me/deposit",
              "host": ["{{base_url}}"],
              "path": ["wallets", "me", "deposit"]
            }
          }
        }
      ]
    }
  ]
}